# ============================================================
# Google Calendar + Telegram 會議通知機器人 - 環境變數模板
# ============================================================
# 警告：這是 .env.example 模板，**不要填真實 token 後 commit**。
# 真實 .env 應該放在 ~/.local/share/hermes/secrets/calendar-bot.env
# 並且 chmod 600。
# ============================================================

# --- Google Calendar OAuth (Device Code Flow) ---
# 從 Google Cloud Console → APIs & Services → Credentials 建立
# 類型必須選「TV 和 limited-input devices」(否則 Device Code Flow 會 401)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# OAuth scope：唯讀 + 寫入事件就夠，**不要加 youtube.force-ssl**
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.events

# --- Telegram Bot ---
# 從 @BotFather → /newbot 拿
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz
# 推播目標 chat_id（個人或群組）
TELEGRAM_CHAT_ID=123456789
# 同時也接受 /start 的白名單 user_id（逗號分隔）
TELEGRAM_ALLOWED_USERS=123456789

# --- 排程 ---
# 提前幾分鐘提醒（預設 5）
REMINDER_LEAD_MINUTES=5
# snooze 後幾分鐘再提醒一次（預設 5）
SNOOZE_MINUTES=5
# 排程器掃描間隔（秒）
POLL_INTERVAL_SECONDS=30
